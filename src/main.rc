/**************************************************************************
 *  File name  :  main.rc
 *
 *  Description:  This resource file contains the menu and string
 *                table definitions.
 *
 *  Concepts   :  resource script
 *
 *  API's      :  [none]
 *
 *  Required
 *    Files    :  OS2.H, MAIN.H, DLG.H
 *************************************************************************/
#include <os2.h>
#include "main.h"
#include "dlg.h"

ICON IDR_MAIN "bbicon.ico"

MENU IDR_MAIN
{
    SUBMENU     "~Game", IDM_FILE, MIS_TEXT
    {
        MENUITEM    "~New Game\tCtrl+N", IDM_FILENEW,    MIS_TEXT
        MENUITEM    "~Load Game",       IDM_FILEOPEN,   MIS_TEXT
        MENUITEM SEPARATOR
        MENUITEM    "~Save Game",       IDM_FILESAVE,   MIS_TEXT
        MENUITEM    "Save Game ~as...", IDM_FILESAVEAS, MIS_TEXT
        MENUITEM SEPARATOR
        MENUITEM    "~Pause Game\tCtrl+P",  IDM_DIRECTION_START,    MIS_TEXT
        MENUITEM SEPARATOR
        MENUITEM    "Sho~w High Scores\tCtrl+H",IDM_HIGHSCORES,   MIS_TEXT
        MENUITEM SEPARATOR
        MENUITEM    "E~xit\tCtrl+X",       IDM_FILEEXIT,   MIS_TEXT
    }

    SUBMENU     "~Options",             IDM_SETTINGS,     MIS_TEXT
    {
        SUBMENU "S~ound",               IDM_SOUND,        MIS_TEXT
           BEGIN
           MENUITEM "O~n",              IDM_SOUND_ON,     MIS_TEXT
           MENUITEM "O~ff",             IDM_SOUND_OFF,    MIS_TEXT
           END
        SUBMENU "St~yle\tCtrl+S",        IDM_STYLE,        MIS_TEXT
           BEGIN
           MENUITEM "~2D",              IDM_STYLE_2D,     MIS_TEXT
           MENUITEM "~3D",              IDM_STYLE_3D,     MIS_TEXT
           END
        SUBMENU "Le~vel",               IDM_LEVEL,        MIS_TEXT
           BEGIN
           MENUITEM "0",                IDM_LEVEL_0,      MIS_TEXT
           MENUITEM "1",                IDM_LEVEL_1,      MIS_TEXT
           MENUITEM "2",                IDM_LEVEL_2,      MIS_TEXT
           MENUITEM "3",                IDM_LEVEL_3,      MIS_TEXT
           MENUITEM "4",                IDM_LEVEL_4,      MIS_TEXT
           MENUITEM "5",                IDM_LEVEL_5,      MIS_TEXT
           MENUITEM "6",                IDM_LEVEL_6,      MIS_TEXT | MIS_BREAK
           MENUITEM "7",                IDM_LEVEL_7,      MIS_TEXT
           MENUITEM "8",                IDM_LEVEL_8,      MIS_TEXT
           MENUITEM "9",                IDM_LEVEL_9,      MIS_TEXT
           MENUITEM "10",               IDM_LEVEL_10,     MIS_TEXT
           MENUITEM "11",               IDM_LEVEL_11,     MIS_TEXT
           END
        MENUITEM    "Visual Se~ttings...", IDM_SETTINGS_ALL, MIS_TEXT
        MENUITEM    "~Key Mapping...",     IDM_KEYMAPPING,   MIS_TEXT
        MENUITEM SEPARATOR
        SUBMENU "L~anguage",             IDM_LANGUAGE,     MIS_TEXT
           BEGIN
           MENUITEM "En~glish",          IDM_LANGUAGE_EN,  MIS_TEXT
           MENUITEM "N~ederlands",       IDM_LANGUAGE_NL,  MIS_TEXT
           MENUITEM "Es~panol",          IDM_LANGUAGE_ES,  MIS_TEXT
           MENUITEM "~Deutsch",          IDM_LANGUAGE_DE,  MIS_TEXT
           MENUITEM "Fran~cais",         IDM_LANGUAGE_FR,  MIS_TEXT
           MENUITEM "It~aliano",         IDM_LANGUAGE_IT,  MIS_TEXT
           END
        MENUITEM SEPARATOR
        MENUITEM    "~Background Run\tCtrl+B", IDM_BACKGRND,    MIS_TEXT
        MENUITEM    "~Frame Controls\tCtrl+F", IDM_FRAME_CTRL,  MIS_TEXT
        MENUITEM SEPARATOR
        MENUITEM    "~Save settings on exit",  IDM_SAVEONEXIT,  MIS_TEXT
    }

/* Application specific menus go here. */
    SUBMENU     "~Help",    IDM_HELP,   MIS_TEXT
    {
        MENUITEM    "~General help",     IDM_HELPGENERAL,    MIS_TEXT
        MENUITEM    "Help ~index",       IDM_HELPINDEX,      MIS_TEXT
        MENUITEM    "~Using help",       IDM_HELPUSINGHELP,  MIS_TEXT
        MENUITEM    "~Keys help",        IDM_HELPKEYS,       MIS_TEXT
        MENUITEM SEPARATOR
        MENUITEM    "~About...",             IDM_HELPPRODUCTINFO, MIS_TEXT
    }
}

/*Popup Menu*/
MENU POPUP_MENU
{
   MENUITEM    "~New Game",        IDM_FILENEW,    MIS_TEXT
   MENUITEM    "~Load Game",       IDM_FILEOPEN,   MIS_TEXT
   MENUITEM    "~Save Game",       IDM_FILESAVE,   MIS_TEXT
   MENUITEM SEPARATOR
   MENUITEM    "~Pause Game",      IDM_DIRECTION_START,    MIS_TEXT
   MENUITEM SEPARATOR
   MENUITEM "Sound O~n",           IDM_SOUND_ON,   MIS_TEXT
   MENUITEM "Sound O~ff",          IDM_SOUND_OFF,  MIS_TEXT
   MENUITEM SEPARATOR
   MENUITEM    "E~xit\tCtrl+X",   IDM_FILEEXIT,   MIS_TEXT
}

ACCELTABLE IDR_MAIN
{
    VK_F3,          IDM_FILEEXIT,         VIRTUALKEY
    "x",            IDM_FILEEXIT,         CONTROL
    "X",            IDM_FILEEXIT,         CONTROL
    VK_BACKSPACE,   IDM_FILEEXIT,         VIRTUALKEY,    ALT
    VK_DELETE,      IDM_FILEEXIT,         VIRTUALKEY,    SHIFT
    VK_INSERT,      IDM_FILEEXIT,         VIRTUALKEY,    CONTROL
    VK_INSERT,      IDM_FILEEXIT,         VIRTUALKEY,    SHIFT
    VK_DELETE,      IDM_FILEEXIT,         VIRTUALKEY
    "s",            IDM_STYLE_TOGGLE,     CONTROL
    "S",            IDM_STYLE_TOGGLE,     CONTROL
    "n",            IDM_FILENEW,          CONTROL
    "N",            IDM_FILENEW,          CONTROL
    "h",            IDM_HIGHSCORES,       CONTROL
    "H",            IDM_HIGHSCORES,       CONTROL
    "p",            IDM_DIRECTION_START,  CONTROL
    "P",            IDM_DIRECTION_START,  CONTROL
    "b",            IDM_BACKGRND,         CONTROL
    "B",            IDM_BACKGRND,         CONTROL
    "f",            IDM_FRAME_CTRL,       CONTROL
    "F",            IDM_FRAME_CTRL,       CONTROL
}

