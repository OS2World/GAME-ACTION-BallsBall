/**************************************************************************
 *
 *  File name  :  lang_nl.rc
 *
 *  Description:  Dutch language resource tables (namespace +10000).
 *		  Pure ASCII text, resource ids are the base ids from
 *		  main.h/dlg.h shifted by LANG_BASE_NL (10000) so a
 *		  single executable can carry all three languages.
 *
 *		  This file is rcinclude'd from main.rc, so it must
 *		  not re-include OS2.H/MAIN.H/DLG.H by itself.
 *
 *  Concepts   :  multilingual single-executable resources
 *
 ***********************************************************************/

