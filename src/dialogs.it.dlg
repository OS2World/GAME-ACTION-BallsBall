/* Italian dialog templates for namespace +50000.
 *
 * Dialog template ids are the base ids from dlg.h shifted by
 * LANG_BASE_IT (50000); control ids are unchanged (they are scoped
 * within their dialog).  All texts are pure ASCII (no accents).
 *
 * This file is rcinclude'd from main.rc, so it must not re-include
 * OS2.H/DLG.H again (already present from main.rc and help.rc scope).
 */

//prodinfo

DLGTEMPLATE 50007 MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Informazioni sul programma", 50007, 132, 42, 277, 169,
                FS_DLGBORDER | WS_VISIBLE, FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        CONTROL IDR_BITMAP,            IDA_BITMAP, 1, 18, 275, 150, WC_STATIC,
                                            SS_BITMAP | WS_GROUP | WS_VISIBLE
        CONTROL "OK",                  DID_OK, 1, 1, 275, 16, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
    END
END

//italian high scores - enter name

DLGTEMPLATE 50256
BEGIN
    DIALOG "Inserisci il tuo nome", 50256, 100, 50, 200, 91, FS_NOBYTEALIGN |
                FS_DLGBORDER | WS_CLIPSIBLINGS | WS_SAVEBITS | WS_VISIBLE,
                FCF_TITLEBAR | FCF_SYSMENU
    PRESPARAMS PP_USER, "10.System Proportional"
    BEGIN
        CONTROL "",                    EF_ENTRYNAME, 16, 36, 168, 10,
                                            WC_ENTRYFIELD, ES_MARGIN |
                                            WS_TABSTOP | WS_VISIBLE
        CONTROL "OK",                  DID_OK, 70, 10, 60, 15, WC_BUTTON,
                                            BS_PUSHBUTTON | BS_DEFAULT |
                                            WS_GROUP | WS_TABSTOP | WS_VISIBLE
        CONTROL "Complimenti! Sei nella Top Ten.", ST_TOPTEN,
                                        15, 70, 170, 12, WC_STATIC, SS_TEXT |
                                            DT_CENTER | DT_VCENTER | WS_GROUP |
                                            WS_VISIBLE
        CONTROL "Nome per la classifica:", ST_ENTRYNAME,
                                        20, 53, 160, 11, WC_STATIC, SS_TEXT |
                                            DT_CENTER | WS_GROUP | WS_VISIBLE
    END
END

//italian high scores

DLGTEMPLATE 50300
BEGIN
    DIALOG "Classifica", 50300, 60, 25, 270, 151, FS_NOBYTEALIGN |
                FS_DLGBORDER | WS_CLIPSIBLINGS | WS_SAVEBITS | WS_VISIBLE,
                FCF_TITLEBAR | FCF_SYSMENU
    PRESPARAMS PP_USER, "10.System Proportional"
    BEGIN
        CONTROL "OK",               DID_OK, 119, 10, 60, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | BS_DEFAULT |
                                            WS_GROUP | WS_TABSTOP | WS_VISIBLE
        CONTROL "Benvenuto nella classifica!", ST_WELCOME, 50, 133, 170, 12,
                                            WC_STATIC, SS_TEXT | DT_CENTER |
                                            DT_VCENTER | WS_GROUP | WS_VISIBLE
                PRESPARAMS PP_FOREGROUNDCOLORINDEX, CLR_RED
        CONTROL "",                    LB_NAMES, 10, 30, 180, 84, WC_LISTBOX,
                                            LS_NOADJUSTPOS | WS_VISIBLE
        CONTROL "",                    LB_SCORES, 200, 30, 60, 84, WC_LISTBOX,
                                            LS_NOADJUSTPOS | WS_VISIBLE
        CONTROL "Nome",           ST_CHAMPIONS, 10, 115, 51, 10, WC_STATIC,
                                            SS_TEXT | DT_VCENTER | WS_GROUP |
                                            WS_VISIBLE
        CONTROL "Punti",               ST_SCORES, 200, 115, 31, 10, WC_STATIC,
                                            SS_TEXT | DT_VCENTER | WS_GROUP |
                                            WS_VISIBLE
    END
END

//italian settings

DLGTEMPLATE 50400
BEGIN
    DIALOG "Opzioni", 50400, 50, 25, 285, 171, FS_NOBYTEALIGN |
                FS_DLGBORDER | WS_CLIPSIBLINGS | WS_SAVEBITS | WS_VISIBLE,
                FCF_TITLEBAR | FCF_SYSMENU
    PRESPARAMS PP_USER, "10.System Proportional"
    BEGIN
        CONTROL "OK",                  DID_OK, 8, 22, 60, 14, WC_BUTTON,
                                            BS_PUSHBUTTON | BS_DEFAULT |
                                            WS_GROUP | WS_TABSTOP | WS_VISIBLE
        CONTROL "Annulla",             DID_CANCEL, 8, 5, 60, 14, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Predefinito",         PB_DEFAULT, 75, 22, 60, 14, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Colori",              GB_COLORS, 8, 64, 270, 104, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "Corridore",           RB_RUNNER, 16, 149, 52, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Cacciatori",          RB_HUNTERS, 16, 139, 52, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Palle",               RB_BALLS, 16, 129, 45, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Campo",               RB_FIELD, 16, 119, 40, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Percorsi",            RB_WAYS, 16, 109, 40, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Nuovi percorsi",      RB_NEWWAYS, 16, 99, 75, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Percorsi rotti",      RB_BREAKWAYS, 16, 89, 75, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Sfondo testo",        RB_TEXTBACK, 16, 79, 85, 11, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Testo",               RB_TEXTFORE, 16, 69, 83, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Blu",                 PB_BLUE, 99, 147, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_BLUE
        CONTROL "Ciano",               PB_CYAN, 99, 134, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_CYAN
        CONTROL "Grigio",              PB_GRAY, 99, 121, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_PALEGRAY
        CONTROL "Verde",               PB_GREEN, 99, 108, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_GREEN
        CONTROL "Rosa",                PB_PINK, 99, 95, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_PINK
        CONTROL "Rosso",               PB_RED, 99, 82, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_RED
        CONTROL "Giallo",              PB_YELLOW, 99, 69, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_YELLOW
        CONTROL "Esempio",             GB_SAMPLE, 156, 69, 115, 94, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "Celle",               GB_CELLS, 8, 40, 270, 22, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "",                    EF_BMPSIZE, 70, 45, 28, 8, WC_ENTRYFIELD,
                                            ES_MARGIN | WS_TABSTOP | WS_VISIBLE
                CTLDATA 8, 32, 0, 0
        CONTROL "Dimensione cella:",   ST_SIZE, 12, 44, 56, 8, WC_STATIC,
                                            SS_TEXT | WS_GROUP | WS_VISIBLE
        CONTROL "",                    EF_COL, 157, 45, 28, 8, WC_ENTRYFIELD,
                                            ES_MARGIN | WS_TABSTOP | WS_VISIBLE
                CTLDATA 8, 32, 0, 0
        CONTROL "Colonne:",            ST_COLUMNS, 114, 44, 37, 8, WC_STATIC,
                                            SS_TEXT | WS_GROUP | WS_VISIBLE
        CONTROL "",                    EF_ROW, 241, 45, 28, 8, WC_ENTRYFIELD,
                                            ES_MARGIN | WS_TABSTOP | WS_VISIBLE
                CTLDATA 8, 32, 0, 0
        CONTROL "Righe:",              ST_ROWS, 210, 44, 28, 8, WC_STATIC,
                                            SS_TEXT | WS_GROUP | WS_VISIBLE
        CONTROL "Stile",               GB_STYLE, 141, 5, 42, 33, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "2D",                  RB_2D, 147, 20, 25, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "3D",                  RB_3D, 147, 9, 23, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Altro",               GB_OTHER, 191, 5, 87, 33, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "Suono",               CB_SOUND, 197, 20, 42, 10, WC_BUTTON,
                                            BS_AUTOCHECKBOX | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Ferma in pausa",      CB_HALT, 197, 9, 75, 10, WC_BUTTON,
                                            BS_AUTOCHECKBOX | WS_TABSTOP |
                                            WS_VISIBLE
    END
END
