/* German dialog templates for namespace +30000.
 *
 * Dialog template ids are the base ids from dlg.h shifted by
 * LANG_BASE_DE (30000); control ids are unchanged (they are scoped
 * within their dialog).  All texts are pure ASCII (no umlauts).
 *
 * This file is rcinclude'd from main.rc, so it must not re-include
 * OS2.H/DLG.H again (already present from main.rc and help.rc scope).
 */

//prodinfo

DLGTEMPLATE 30007 MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Ueber dieses Programm", 30007, 132, 42, 277, 169,
                FS_DLGBORDER | WS_VISIBLE, FCF_TITLEBAR | FCF_SYSMENU
    BEGIN
        CONTROL IDR_BITMAP,            IDA_BITMAP, 1, 18, 275, 150, WC_STATIC,
                                            SS_BITMAP | WS_GROUP | WS_VISIBLE
        CONTROL "OK",                  DID_OK, 1, 1, 275, 16, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
    END
END

//german high scores - enter name

DLGTEMPLATE 30256
BEGIN
    DIALOG "Geben Sie Ihren Namen ein", 30256, 100, 50, 200, 91, FS_NOBYTEALIGN |
                FS_DLGBORDER | WS_CLIPSIBLINGS | WS_SAVEBITS | WS_VISIBLE,
                FCF_TITLEBAR | FCF_SYSMENU
    PRESPARAMS PP_USER, "10.System Proportional"
    BEGIN
        CONTROL "",                    EF_ENTRYNAME, 16, 36, 168, 10,
                                            WC_ENTRYFIELD, ES_MARGIN |
                                            WS_TABSTOP | WS_VISIBLE
        CONTROL "OK",                  DID_OK, 70, 10, 60, 15, WC_BUTTON,
                                            BS_PUSHBUTTON | BS_DEFAULT |
                                            WS_GROUP | WS_TABSTOP | WS_VISIBLE
        CONTROL "Glueckwunsch! Sie sind in den Top Ten.", ST_TOPTEN,
                                        15, 70, 170, 12, WC_STATIC, SS_TEXT |
                                            DT_CENTER | DT_VCENTER | WS_GROUP |
                                            WS_VISIBLE
        CONTROL "Name fuer die Rekordliste eingeben:", ST_ENTRYNAME,
                                        20, 53, 160, 11, WC_STATIC, SS_TEXT |
                                            DT_CENTER | WS_GROUP | WS_VISIBLE
    END
END

//german high scores

DLGTEMPLATE 30300
BEGIN
    DIALOG "Rekordliste", 30300, 60, 25, 270, 151, FS_NOBYTEALIGN |
                FS_DLGBORDER | WS_CLIPSIBLINGS | WS_SAVEBITS | WS_VISIBLE,
                FCF_TITLEBAR | FCF_SYSMENU
    PRESPARAMS PP_USER, "10.System Proportional"
    BEGIN
        CONTROL "OK",               DID_OK, 119, 10, 60, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | BS_DEFAULT |
                                            WS_GROUP | WS_TABSTOP | WS_VISIBLE
        CONTROL "Willkommen in der Rekordliste!", ST_WELCOME, 50, 133, 170, 12,
                                            WC_STATIC, SS_TEXT | DT_CENTER |
                                            DT_VCENTER | WS_GROUP | WS_VISIBLE
                PRESPARAMS PP_FOREGROUNDCOLORINDEX, CLR_RED
        CONTROL "",                    LB_NAMES, 10, 30, 180, 84, WC_LISTBOX,
                                            LS_NOADJUSTPOS | WS_VISIBLE
        CONTROL "",                    LB_SCORES, 200, 30, 60, 84, WC_LISTBOX,
                                            LS_NOADJUSTPOS | WS_VISIBLE
        CONTROL "Name",           ST_CHAMPIONS, 10, 115, 51, 10, WC_STATIC,
                                            SS_TEXT | DT_VCENTER | WS_GROUP |
                                            WS_VISIBLE
        CONTROL "Punkte",              ST_SCORES, 200, 115, 31, 10, WC_STATIC,
                                            SS_TEXT | DT_VCENTER | WS_GROUP |
                                            WS_VISIBLE
    END
END

//german settings

DLGTEMPLATE 30400
BEGIN
    DIALOG "Einstellungen", 30400, 50, 25, 285, 171, FS_NOBYTEALIGN |
                FS_DLGBORDER | WS_CLIPSIBLINGS | WS_SAVEBITS | WS_VISIBLE,
                FCF_TITLEBAR | FCF_SYSMENU
    PRESPARAMS PP_USER, "10.System Proportional"
    BEGIN
        CONTROL "OK",                  DID_OK, 8, 22, 60, 14, WC_BUTTON,
                                            BS_PUSHBUTTON | BS_DEFAULT |
                                            WS_GROUP | WS_TABSTOP | WS_VISIBLE
        CONTROL "Abbrechen",           DID_CANCEL, 8, 5, 60, 14, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Standard",            PB_DEFAULT, 75, 22, 60, 14, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Farben",              GB_COLORS, 8, 64, 270, 104, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "Renner",              RB_RUNNER, 16, 149, 52, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Jaeger",              RB_HUNTERS, 16, 139, 52, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Baelle",              RB_BALLS, 16, 129, 45, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Feld",                RB_FIELD, 16, 119, 40, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Wege",                RB_WAYS, 16, 109, 40, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Neue Wege",           RB_NEWWAYS, 16, 99, 75, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Kaputte Wege",        RB_BREAKWAYS, 16, 89, 75, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Text Hintergrund",    RB_TEXTBACK, 16, 79, 85, 11, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Text",                RB_TEXTFORE, 16, 69, 83, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Blau",                PB_BLUE, 99, 147, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_BLUE
        CONTROL "Cyan",                PB_CYAN, 99, 134, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_CYAN
        CONTROL "Grau",                PB_GRAY, 99, 121, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_PALEGRAY
        CONTROL "Gruen",               PB_GREEN, 99, 108, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_GREEN
        CONTROL "Rosa",                PB_PINK, 99, 95, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_PINK
        CONTROL "Rot",                 PB_RED, 99, 82, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_RED
        CONTROL "Gelb",                PB_YELLOW, 99, 69, 55, 12, WC_BUTTON,
                                            BS_PUSHBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
                PRESPARAMS PP_BACKGROUNDCOLORINDEX, CLR_YELLOW
        CONTROL "Beispiel",            GB_SAMPLE, 156, 69, 115, 94, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "Zellen",              GB_CELLS, 8, 40, 270, 22, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "",                    EF_BMPSIZE, 70, 45, 28, 8, WC_ENTRYFIELD,
                                            ES_MARGIN | WS_TABSTOP | WS_VISIBLE
                CTLDATA 8, 32, 0, 0
        CONTROL "Zellengroesse:",      ST_SIZE, 12, 44, 56, 8, WC_STATIC,
                                            SS_TEXT | WS_GROUP | WS_VISIBLE
        CONTROL "",                    EF_COL, 157, 45, 28, 8, WC_ENTRYFIELD,
                                            ES_MARGIN | WS_TABSTOP | WS_VISIBLE
                CTLDATA 8, 32, 0, 0
        CONTROL "Spalten:",            ST_COLUMNS, 114, 44, 37, 8, WC_STATIC,
                                            SS_TEXT | WS_GROUP | WS_VISIBLE
        CONTROL "",                    EF_ROW, 241, 45, 28, 8, WC_ENTRYFIELD,
                                            ES_MARGIN | WS_TABSTOP | WS_VISIBLE
                CTLDATA 8, 32, 0, 0
        CONTROL "Zeilen:",             ST_ROWS, 210, 44, 28, 8, WC_STATIC,
                                            SS_TEXT | WS_GROUP | WS_VISIBLE
        CONTROL "Stil",                GB_STYLE, 141, 5, 42, 33, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "2D",                  RB_2D, 147, 20, 25, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "3D",                  RB_3D, 147, 9, 23, 10, WC_BUTTON,
                                            BS_AUTORADIOBUTTON | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Sonstiges",           GB_OTHER, 191, 5, 87, 33, WC_STATIC,
                                            SS_GROUPBOX | WS_GROUP | WS_VISIBLE
        CONTROL "Ton",                 CB_SOUND, 197, 20, 42, 10, WC_BUTTON,
                                            BS_AUTOCHECKBOX | WS_TABSTOP |
                                            WS_VISIBLE
        CONTROL "Bei Pause anhalten",  CB_HALT, 197, 9, 75, 10, WC_BUTTON,
                                            BS_AUTOCHECKBOX | WS_TABSTOP |
                                            WS_VISIBLE
    END
END
