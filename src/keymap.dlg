/* Key Mapping dialog: the texts are set from the string table at run time */
DLGTEMPLATE DLG_KEYMAPPING MOVEABLE DISCARDABLE
BEGIN
    DIALOG "Key Mapping", DLG_KEYMAPPING, 30, 30, 242, 232,
        FS_NOBYTEALIGN|FS_DLGBORDER|WS_VISIBLE|WS_SAVEBITS,
        FCF_TITLEBAR
    BEGIN
        PUSHBUTTON "Ok",     DID_OK,      62,  4, 44, 14, WS_GROUP
        PUSHBUTTON "Cancel", DID_CANCEL, 120,  4, 44, 14
    END
END

DLGTEMPLATE DLG_KM_KEYBOARD MOVEABLE DISCARDABLE
BEGIN
    DIALOG "", DLG_KM_KEYBOARD, 0, 0, 200, 130, WS_VISIBLE
    BEGIN
        CTEXT "", IDC_KM_KH1, 4, 118, 192, 8
        CTEXT "", IDC_KM_KH2, 4, 108, 192, 8
        LTEXT "", IDC_KM_KL1+0, 8, 92, 80, 8
        ENTRYFIELD "", IDC_KM_KBD1+0, 92, 90, 96, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP | WS_GROUP
        LTEXT "", IDC_KM_KL1+1, 8, 76, 80, 8
        ENTRYFIELD "", IDC_KM_KBD1+1, 92, 74, 96, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "", IDC_KM_KL1+2, 8, 60, 80, 8
        ENTRYFIELD "", IDC_KM_KBD1+2, 92, 58, 96, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "", IDC_KM_KL1+3, 8, 44, 80, 8
        ENTRYFIELD "", IDC_KM_KBD1+3, 92, 42, 96, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "", IDC_KM_KL1+4, 8, 28, 80, 8
        ENTRYFIELD "", IDC_KM_KBD1+4, 92, 26, 96, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
    END
END

DLGTEMPLATE DLG_KM_JOYSTICK MOVEABLE DISCARDABLE
BEGIN
    DIALOG "", DLG_KM_JOYSTICK, 0, 0, 200, 170, WS_VISIBLE
    BEGIN
        AUTOCHECKBOX "Enable Joystick", IDC_KM_JOY_EN, 4, 154, 120, 12, WS_GROUP
        AUTORADIOBUTTON "Joystick A", IDC_KM_JOY_A, 16, 140, 74, 11, WS_GROUP
        AUTORADIOBUTTON "Joystick B", IDC_KM_JOY_B, 94, 140, 74, 11
        CTEXT "", IDC_KM_JH1, 4, 126, 192, 8, WS_GROUP
        CTEXT "", IDC_KM_JH2, 4, 116, 192, 8
        LTEXT "", IDC_KM_JL1+0, 4, 100, 82, 8
        ENTRYFIELD "", IDC_KM_JBTN1+0, 90, 98, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP | WS_GROUP
        LTEXT "", IDC_KM_JL1+1, 4, 84, 82, 8
        ENTRYFIELD "", IDC_KM_JBTN1+1, 90, 82, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "", IDC_KM_JL1+2, 4, 68, 82, 8
        ENTRYFIELD "", IDC_KM_JBTN1+2, 90, 66, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "", IDC_KM_JL1+3, 4, 52, 82, 8
        ENTRYFIELD "", IDC_KM_JBTN1+3, 90, 50, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "", IDC_KM_JL1+4, 4, 36, 82, 8
        ENTRYFIELD "", IDC_KM_JBTN1+4, 90, 34, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        LTEXT "", IDC_KM_JL1+5, 4, 20, 82, 8
        ENTRYFIELD "", IDC_KM_JBTN1+5, 90, 18, 100, 12, ES_MARGIN | ES_READONLY | WS_TABSTOP
        PUSHBUTTON "Calibrate A", IDC_KM_CAL,   4, 1, 70, 14, WS_GROUP
        PUSHBUTTON "Calibrate B", IDC_KM_CALB, 80, 1, 70, 14
    END
END
